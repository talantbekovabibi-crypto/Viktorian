<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Викторина</title>
<link rel="stylesheet" href="style.css">
</head>
<body>
<div class="box">
<h1>🧠 Викторина</h1>
<p id="progress"></p>
<h3 id="question"></h3>
<div id="answers"></div>
<p id="result"></p>
<button id="next" onclick="nextQuestion()" hidden>Дальше</button>
</div>
<script scr="app.js"></script>
</body>
</html>


*body{font-family:Arial;background:#e0f4ff;display:grid;place-items:center;min-height:100vh;margin:0}
.box{background:white;padding:25px;border-radius:20px;width:min(400px,85vw)}
h1{color:#2686b5;text-align:center}
button{display:block;width:100%;padding:13px;margin:8px 0;border:0;border-radius:9px;background:#d9f1ff;cursor:pointer}
button:hover{background:#9cddf8}
#next{background:#70c9ef}

const questions=[
{q:'Столица Кыргызстана?',a:['Ош','Бишкек','Нарын'],correct:1},
{q:'Сколько будет 5 × 5?',a:['10','20','25'],correct:2},
{q:'Какая планета известна как Красная планета?',a:['Марс','Венера','Юпитер'],correct:0},
{q:'Сколько дней в обычной неделе?',a:['5','7','10'],correct:1},
{q:'Какой язык используется для разметки веб-страниц?',a:['HTML','SQL','Python'],correct:0}
];
let index=0,score=0,answered=false;
function render(){
answered=false;
document.getElementById('progress').textContent=`Вопрос ${index+1} из ${questions.length}`;
document.getElementById('question').textContent=questions[index].q;
document.getElementById('result').textContent='';
document.getElementById('next').hidden=true;
let box=document.getElementById('answers');
box.replaceChildren();
questions[index].a.forEach((answer,i)=>{
let button=document.createElement('button');
button.textContent=answer;
button.onclick=()=>check(i);
box.append(button);
});
}
function check(choice){
if(answered)return;
answered=true;
if(choice===questions[index].correct){
score++;
document.getElementById('result').textContent='Правильно! 🎉';
}else{
document.getElementById('result').textContent='Не совсем! Правильный ответ: '+questions[index].a[questions[index].correct];
}
document.getElementById('next').hidden=false;
}
function nextQuestion(){
index++;
if(index<questions.length){render();return}
document.getElementById('progress').textContent='Викторина завершена!';
document.getElementById('question').textContent=`Твой результат: ${score} из ${questions.length}`;
document.getElementById('answers').replaceChildren();
document.getElementById('result').textContent='Молодец! 💙';
document.getElementById('next').textContent='Начать заново';
document.getElementById('next').onclick=()=>{index=0;score=0;document.getElementById('next').textContent='Дальше';document.getElementById('next').onclick=nextQuestion;render()};
}
render();
